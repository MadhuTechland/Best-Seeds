// Copy this file to Secrets.xcconfig (gitignored) and fill in the real value.
//
// It is #include'd by Debug.xcconfig / Release.xcconfig, surfaced into
// Info.plist as GoogleMapsApiKey, and read by AppDelegate.swift at launch.
//
// Use the iOS-restricted key (bundle id com.driver.bestseed).
GOOGLE_MAPS_API_KEY = AIza-your-ios-maps-key-here
